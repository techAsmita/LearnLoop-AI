# ============================================================
# LearnLoop AI — Environment Variables
# Copy this file to backend/.env and frontend/.env.local
# ============================================================

# --- Backend (place in backend/.env) ---
# Leave empty or set MOCK_MODE=true to run fully offline
GEMINI_API_KEY=
MOCK_MODE=true

# SQLite (default, zero-config local development)
DATABASE_URL=sqlite:///./learnloop.db

# To use PostgreSQL / Supabase later, change to:
# DATABASE_URL=postgresql://user:password@host:5432/learnloop

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (place in frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
